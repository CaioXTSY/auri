# Application
# Environment and HTTP server settings.
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_TIME_ZONE=America/Sao_Paulo

# Database
# Uses the Compose service name. Replace `db` with `localhost` for local MySQL.
DATABASE_URL="mysql://auri:change-this-password@db:3306/auri"
# Values consumed by the MySQL service in docker compose.
MYSQL_DATABASE=auri
MYSQL_USER=auri
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Authentication / JWT
# Replace both secrets with long random values outside local development.
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# URLs and CORS
CORS_ORIGINS=http://localhost:5173
# Backwards-compatible single-origin fallback.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# SMTP / email (leave blank to disable delivery in local development)
SMTP_HOST=
SMTP_TLS_SERVERNAME=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Auri <no-reply@example.com>"

# OpenAI daily quiz generation (leave the API key blank to disable it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional separate semantic reviewer. AI agreement is not pedagogical proof.
OPENAI_REVIEW_MODEL=gpt-4.1-mini
# human (default): generated daily quiz waits for authorized approval.
# automatic: explicitly preserve unattended publication, recorded as such.
QUIZ_REVIEW_MODE=human
# Set false for isolated deterministic tests, without changing the API credential.
QUIZ_GENERATION_ENABLED=true

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads

# Code runner (deploy in a separate, dedicated host in production)
CODE_RUNNER_ENABLED=true
CODE_RUNNER_POLL_INTERVAL_MS=1000
CODE_RUNNER_MAX_PARALLEL=1
CODE_RUNNER_JS_IMAGE=node:20-alpine
CODE_RUNNER_PY_IMAGE=python:3.12-alpine
CODE_RUNNER_DEFAULT_TIMEOUT_MS=5000
CODE_RUNNER_STARTUP_GRACE_MS=5000
CODE_RUNNER_DEFAULT_MEMORY_MB=128
CODE_RUNNER_DEFAULT_CPUS=0.5
CODE_RUNNER_MAX_OUTPUT_BYTES=65536
