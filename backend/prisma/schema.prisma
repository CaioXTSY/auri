generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

enum ActivityType {
  EXERCICIO
  QUIZ
  DESAFIO
  PROJETO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum SubmissionStatus {
  PENDENTE
  EXECUTANDO
  APROVADO
  PARCIAL
  REPROVADO
  ERRO
}

enum MissionType {
  DIARIA
  SEMANAL
  PERSONALIZADA
}

enum MissionStatus {
  NAO_INICIADA
  EM_PROGRESSO
  CONCLUIDA
  EXPIRADA
}

enum NotificationType {
  SISTEMA
  ATIVIDADE
  CONQUISTA
  MISSAO
  RANKING
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  role              Role     @default(ALUNO)
  avatar            String?
  refreshToken      String?  @map("refresh_token") @db.Text
  resetToken        String?  @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relações
  createdDisciplines Discipline[]
  classEnrollments   ClassStudent[]
  createdActivities  Activity[]
  submissions        Submission[]
  points             UserPoint[]
  achievements       UserAchievement[]
  rankings           Ranking[]
  missions           UserMission[]
  notifications      Notification[]
  aiGenerations      AIGeneration[]

  @@map("users")
}

model Discipline {
  id          String     @id @default(uuid())
  name        String
  description String?    @db.Text
  language    String     // Python, Java, C, etc
  status      String     @default("ATIVA") // ATIVA, ENCERRADA
  createdById String     @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relações
  createdBy  User       @relation(fields: [createdById], references: [id])
  classes    Class[]
  activities Activity[]

  @@map("disciplines")
}

model Class {
  id           String   @id @default(uuid())
  disciplineId String   @map("discipline_id")
  name         String
  semester     String
  year         Int
  code         String   @unique @default(cuid()) // Código único para entrar na turma
  status       String   @default("ATIVA") // ATIVA, ENCERRADA
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relações
  discipline Discipline     @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  students   ClassStudent[]
  activities Activity[]
  missions   Mission[]

  @@map("classes")
}

model ClassStudent {
  classId    String   @map("class_id")
  userId     String   @map("user_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  // Relações
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@map("class_students")
}

model Activity {
  id                  String       @id @default(uuid())
  classId             String?      @map("class_id")
  disciplineId        String       @map("discipline_id")
  title               String       @db.VarChar(200)
  description         String       @db.Text
  type                ActivityType
  difficulty          Difficulty
  points            Int
  starterCode       String?      @db.Text @map("starter_code")
  deadline          DateTime?
  allowLateSubmission Boolean      @default(true) @map("allow_late_submission")
  status              String       @default("ATIVA")
  timeLimit           Int          @default(2) @map("time_limit") // tempo limite em segundos
  memoryLimit         Int          @default(128000) @map("memory_limit") // memória limite em KB (128MB)
  createdById         String       @map("created_by_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relações
  class       Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  discipline  Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  submissions Submission[]
  testCases   TestCase[]

  @@map("activities")
}

model TestCase {
  id             String   @id @default(uuid())
  activityId     String   @map("activity_id")
  input          String   @db.Text
  expectedOutput String   @db.Text @map("expected_output")
  points         Int
  isVisible      Boolean  @default(true) @map("is_visible")
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  // Relações
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Submission {
  id            String           @id @default(uuid())
  activityId    String           @map("activity_id")
  userId        String           @map("user_id")
  code          String           @db.Text
  language      String
  status        SubmissionStatus @default(PENDENTE)
  result        String?          @db.Text
  executionTime Int?             @map("execution_time") // em ms
  memoryUsed    Int?             @map("memory_used") // em KB
  pointsEarned  Int              @default(0) @map("points_earned")
  submittedAt   DateTime         @default(now()) @map("submitted_at")

  // Relações
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model UserPoint {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  points      Int      // Pontos ganhos nesta transação
  source      String   // ATIVIDADE, CONQUISTA, BONUS_PROFESSOR, MISSAO
  description String   @db.Text
  referenceId String?  @map("reference_id") // ID da atividade, conquista, etc
  createdAt   DateTime @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  icon        String?
  category    String   // SUBMISSÕES, PONTOS, NÍVEIS, ESPECIAL, etc
  points      Int      @default(0)
  rarity      String   @default("COMUM") // COMUM, INCOMUM, RARO, ÉPICO, LENDÁRIO
  condition   String   @unique // Identificador único para verificação automática
  criteria    String   @db.Text // JSON com critérios detalhados
  createdAt   DateTime @default(now()) @map("created_at")

  // Relações
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")
  earnedAt      DateTime @default(now()) @map("earned_at")

  // Relações
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   // GLOBAL, DISCIPLINA, TURMA
  referenceId String?  @map("reference_id") // disciplineId ou classId
  position    Int      // Posição no ranking
  points      Int      // Pontos totais
  period      String   @default("GERAL") // SEMANAL, MENSAL, GERAL
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([userId, type, referenceId])
  @@map("rankings")
}

model Mission {
  id          String      @id @default(uuid())
  classId     String?     @map("class_id")
  title       String
  description String      @db.Text
  type        MissionType
  points      Int         @default(0)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relações
  class        Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  userMissions UserMission[]

  @@map("missions")
}

model UserMission {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  missionId   String        @map("mission_id")
  status      MissionStatus @default(NAO_INICIADA)
  progress    Int           @default(0)
  completedAt DateTime?     @map("completed_at")
  startedAt   DateTime      @default(now()) @map("started_at")

  // Relações
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("user_missions")
}

model AIGeneration {
  id         String   @id @default(uuid())
  type       String   // QUESTAO, QUIZ, MISSAO, MOTIVACIONAL
  prompt     String   @db.Text
  response   String   @db.Text
  reviewedBy String?  @map("reviewed_by")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relações
  reviewer User? @relation(fields: [reviewedBy], references: [id])

  @@map("ai_generations")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
