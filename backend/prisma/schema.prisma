generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum MissionType {
  DIARIA
  SEMANAL
  PERSONALIZADA
}

enum MissionStatus {
  NAO_INICIADA
  EM_PROGRESSO
  CONCLUIDA
  EXPIRADA
}

enum NotificationType {
  SISTEMA
  CONQUISTA
  MISSAO
  RANKING
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProgrammingLanguage {
  JAVASCRIPT
  PYTHON
}

enum CodeSubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum CodeSubmissionMode {
  RUN
  SUBMIT
}

enum TestCaseVisibility {
  PUBLIC
  HIDDEN
}

enum ActivityType {
  TEXT
  FILE
  QUIZ
  CODE
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  UNDER_REVIEW
  GRADED
  RETURNED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String
  role              Role      @default(ALUNO)
  avatar            String?
  refreshToken      String?   @map("refresh_token") @db.Text
  resetToken        String?   @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  currentStreak     Int       @default(0) @map("current_streak")
  longestStreak     Int       @default(0) @map("longest_streak")
  streakLastDate    DateTime? @map("streak_last_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  classEnrollments    ClassStudent[]
  points              UserPoint[]
  achievements        UserAchievement[]
  rankings            Ranking[]
  missions            UserMission[]
  missionQuizAttempts MissionQuizAttempt[]
  notifications       Notification[]
  posts               Post[]
  postReplies         PostReply[]
  createdClasses      Class[]
  classJoinRequests   ClassJoinRequest[]
  programmingProblems ProgrammingProblem[]
  codeSubmissions     CodeSubmission[]
  createdActivities   Activity[]           @relation("ActivityCreator")
  activitySubmissions ActivitySubmission[] @relation("SubmissionStudent")
  gradedSubmissions   ActivitySubmission[] @relation("SubmissionGrader")

  @@map("users")
}

model Class {
  id          String   @id @default(uuid())
  name        String
  year        Int
  code        String   @unique @default(cuid())
  status      String   @default("ATIVA")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy              User?                   @relation(fields: [createdById], references: [id])
  students               ClassStudent[]
  missions               Mission[]
  posts                  Post[]
  settings               ClassSettings?
  joinRequests           ClassJoinRequest[]
  programmingAssignments ProgrammingAssignment[]
  activities             Activity[]

  @@map("classes")
}

model ClassSettings {
  id                    String   @id @default(uuid())
  classId               String   @unique @map("class_id")
  allowStudentPosts     Boolean  @default(true) @map("allow_student_posts")
  allowStudentReplies   Boolean  @default(true) @map("allow_student_replies")
  requirePostApproval   Boolean  @default(false) @map("require_post_approval")
  requireReplyApproval  Boolean  @default(false) @map("require_reply_approval")
  allowJoinByCode       Boolean  @default(true) @map("allow_join_by_code")
  requireJoinApproval   Boolean  @default(false) @map("require_join_approval")
  lockEnrollment        Boolean  @default(false) @map("lock_enrollment")
  activitiesEnabled     Boolean  @default(false) @map("activities_enabled")
  allowLateSubmissions  Boolean  @default(false) @map("allow_late_submissions")
  showRankingToStudents Boolean  @default(true) @map("show_ranking_to_students")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_settings")
}

model ClassJoinRequest {
  id           String            @id @default(uuid())
  classId      String            @map("class_id")
  userId       String            @map("user_id")
  status       JoinRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  reviewedAt   DateTime?         @map("reviewed_at")
  reviewedById String?           @map("reviewed_by_id")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@map("class_join_requests")
}

model ClassStudent {
  classId    String   @map("class_id")
  userId     String   @map("user_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@map("class_students")
}

model UserPoint {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  points      Int
  source      String
  description String   @db.Text
  referenceId String?  @map("reference_id")
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  icon        String?
  category    String
  points      Int      @default(0)
  rarity      String   @default("COMUM")
  condition   String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  referenceId String?  @map("reference_id")
  position    Int
  points      Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, referenceId])
  @@index([type, referenceId, position])
  @@map("rankings")
}

model Mission {
  id          String      @id @default(uuid())
  classId     String?     @map("class_id")
  title       String
  description String      @db.Text
  type        MissionType
  points      Int         @default(0)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  createdById String?     @map("created_by_id")
  dailyKey    String?     @unique @map("daily_key") @db.VarChar(10)
  createdAt   DateTime    @default(now()) @map("created_at")

  class        Class?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz         MissionQuiz?
  userMissions UserMission[]
  quizAttempts MissionQuizAttempt[]

  @@map("missions")
}

model MissionQuiz {
  id             String     @id @default(uuid())
  missionId      String     @unique @map("mission_id")
  title          String     @db.VarChar(200)
  question       String     @db.Text
  difficulty     Difficulty
  options        Json
  explanations   Json
  correctIndex   Int        @map("correct_index")
  aiGenerationId String?    @map("ai_generation_id")
  reviewStatus   String     @default("APPROVED") @map("review_status") @db.VarChar(20)
  reviewedById   String?    @map("reviewed_by_id")
  reviewedAt     DateTime?  @map("reviewed_at")
  reviewReason   String?    @map("review_reason") @db.Text
  qualityWarnings Json?    @map("quality_warnings")
  createdAt      DateTime   @default(now()) @map("created_at")

  mission      Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  aiGeneration AIGeneration?        @relation(fields: [aiGenerationId], references: [id])
  attempts     MissionQuizAttempt[]

  @@map("mission_quizzes")
}

model MissionQuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  missionId     String   @map("mission_id")
  missionQuizId String   @map("mission_quiz_id")
  selectedIndex Int      @map("selected_index")
  isCorrect     Boolean  @map("is_correct")
  answeredAt    DateTime @default(now()) @map("answered_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionQuiz MissionQuiz @relation(fields: [missionQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_quiz_attempts")
}

model UserMission {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  missionId   String        @map("mission_id")
  status      MissionStatus @default(NAO_INICIADA)
  progress    Int           @default(0)
  completedAt DateTime?     @map("completed_at")
  startedAt   DateTime      @default(now()) @map("started_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("user_missions")
}

model AIGeneration {
  id                 String   @id @default(uuid())
  type               String
  prompt             String   @db.Text
  response           String   @db.Text
  model              String?
  inputTokens        Int?     @map("input_tokens")
  outputTokens       Int?     @map("output_tokens")
  totalTokens        Int?     @map("total_tokens")
  generationAttempts Int?     @map("generation_attempts")
  validationCalls    Int?     @map("validation_calls")
  requestedDifficulty String? @map("requested_difficulty")
  returnedDifficulty String?  @map("returned_difficulty")
  status             String?  @db.VarChar(20)
  callAudit          Json?    @map("call_audit")
  createdAt          DateTime @default(now()) @map("created_at")

  missionQuizzes MissionQuiz[]

  @@map("ai_generations")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Post {
  id        String           @id @default(uuid())
  classId   String           @map("class_id")
  authorId  String           @map("author_id")
  title     String
  content   String           @db.Text
  status    ModerationStatus @default(APPROVED)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies PostReply[]

  @@map("posts")
}

model PostReply {
  id        String           @id @default(uuid())
  postId    String           @map("post_id")
  authorId  String           @map("author_id")
  content   String           @db.Text
  status    ModerationStatus @default(APPROVED)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("post_replies")
}

model ProgrammingProblem {
  id               String     @id @default(uuid())
  title            String
  statement        String     @db.Text
  difficulty       Difficulty @default(FACIL)
  allowedLanguages Json       @map("allowed_languages")
  starterCode      Json       @map("starter_code")
  timeLimitMs      Int        @default(5000) @map("time_limit_ms")
  memoryLimitMb    Int        @default(128) @map("memory_limit_mb")
  createdById      String     @map("created_by_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  createdBy   User                    @relation(fields: [createdById], references: [id])
  testCases   ProblemTestCase[]
  assignments ProgrammingAssignment[]
  submissions CodeSubmission[]

  @@map("programming_problems")
}

model ProblemTestCase {
  id         String             @id @default(uuid())
  problemId  String             @map("problem_id")
  input      String             @db.Text
  expected   String             @db.Text
  visibility TestCaseVisibility @default(HIDDEN)
  weight     Int                @default(1)
  createdAt  DateTime           @default(now()) @map("created_at")

  problem ProgrammingProblem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results SubmissionTestResult[]

  @@map("problem_test_cases")
}

model ProgrammingAssignment {
  id        String    @id @default(uuid())
  problemId String    @map("problem_id")
  classId   String    @map("class_id")
  title     String
  points    Int       @default(0)
  dueDate   DateTime? @map("due_date")
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  problem     ProgrammingProblem @relation(fields: [problemId], references: [id])
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions CodeSubmission[]

  @@map("programming_assignments")
}

model CodeSubmission {
  id            String               @id @default(uuid())
  problemId     String               @map("problem_id")
  assignmentId  String?              @map("assignment_id")
  userId        String               @map("user_id")
  language      ProgrammingLanguage
  code          String               @db.Text
  mode          CodeSubmissionMode   @default(SUBMIT)
  status        CodeSubmissionStatus @default(PENDING)
  score         Int                  @default(0)
  pointsAwarded Int                  @default(0) @map("points_awarded")
  passedTests   Int                  @default(0) @map("passed_tests")
  totalTests    Int                  @default(0) @map("total_tests")
  runtimeMs     Int?                 @map("runtime_ms")
  errorMessage  String?              @map("error_message") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  startedAt     DateTime?            @map("started_at")
  judgedAt      DateTime?            @map("judged_at")

  problem    ProgrammingProblem     @relation(fields: [problemId], references: [id])
  assignment ProgrammingAssignment? @relation(fields: [assignmentId], references: [id])
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  results    SubmissionTestResult[]

  @@index([status, createdAt])
  @@index([userId, assignmentId])
  @@map("code_submissions")
}

model SubmissionTestResult {
  id           String               @id @default(uuid())
  submissionId String               @map("submission_id")
  testCaseId   String?              @map("test_case_id")
  status       CodeSubmissionStatus
  inputPreview String?              @map("input_preview") @db.Text
  expected     String?              @db.Text
  actual       String?              @db.Text
  errorMessage String?              @map("error_message") @db.Text
  runtimeMs    Int?                 @map("runtime_ms")

  submission CodeSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   ProblemTestCase? @relation(fields: [testCaseId], references: [id])

  @@map("submission_test_results")
}

model Activity {
  id                     String         @id @default(uuid())
  classId                String         @map("class_id")
  createdById            String         @map("created_by_id")
  type                   ActivityType
  status                 ActivityStatus @default(DRAFT)
  title                  String         @db.VarChar(200)
  description            String         @db.Text
  maxScore               Int            @default(100) @map("max_score")
  xpReward               Int            @default(0) @map("xp_reward")
  dueDate                DateTime?      @map("due_date")
  allowLateSubmissions   Boolean        @default(false) @map("allow_late_submissions")
  allowResubmission      Boolean        @default(false) @map("allow_resubmission")
  maxAttempts            Int            @default(1) @map("max_attempts")
  allowedFileTypes       Json?          @map("allowed_file_types")
  maxFileSize            Int            @default(10485760) @map("max_file_size")
  maxFiles               Int            @default(5) @map("max_files")
  showResultsImmediately Boolean        @default(false) @map("show_results_immediately")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("ActivityCreator", fields: [createdById], references: [id])
  questions   ActivityQuestion[]
  materials   ActivityMaterial[]
  submissions ActivitySubmission[]

  @@index([classId, status, dueDate])
  @@index([createdById, status])
  @@map("activities")
}

model ActivityQuestion {
  id         String       @id @default(uuid())
  activityId String       @map("activity_id")
  type       QuestionType
  prompt     String       @db.Text
  points     Int          @default(0)
  position   Int
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  activity Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  options  QuestionOption[]
  answers  QuestionAnswer[]

  @@unique([activityId, position])
  @@index([activityId, type])
  @@map("activity_questions")
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  text       String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")
  position   Int

  question ActivityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuestionAnswer[]

  @@unique([questionId, position])
  @@index([questionId, isCorrect])
  @@map("question_options")
}

model ActivityMaterial {
  id           String   @id @default(uuid())
  activityId   String   @map("activity_id")
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  path         String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("activity_materials")
}

model ActivitySubmission {
  id            String           @id @default(uuid())
  activityId    String           @map("activity_id")
  userId        String           @map("user_id")
  attemptNumber Int              @map("attempt_number")
  status        SubmissionStatus @default(DRAFT)
  textAnswer    String?          @map("text_answer") @db.Text
  score         Int?
  xpAwarded     Int              @default(0) @map("xp_awarded")
  feedback      String?          @db.Text
  submittedAt   DateTime?        @map("submitted_at")
  gradedAt      DateTime?        @map("graded_at")
  gradedById    String?          @map("graded_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  activity    Activity               @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user        User                   @relation("SubmissionStudent", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy    User?                  @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  attachments SubmissionAttachment[]
  answers     QuestionAnswer[]

  @@unique([activityId, userId, attemptNumber])
  @@index([activityId, status, submittedAt])
  @@index([userId, status, updatedAt])
  @@index([gradedById])
  @@map("activity_submissions")
}

model SubmissionAttachment {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  path         String   @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  submission ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_attachments")
}

model QuestionAnswer {
  id               String   @id @default(uuid())
  submissionId     String   @map("submission_id")
  questionId       String   @map("question_id")
  selectedOptionId String?  @map("selected_option_id")
  textAnswer       String?  @map("text_answer") @db.Text
  score            Int?
  feedback         String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  submission     ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       ActivityQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("question_answers")
}
