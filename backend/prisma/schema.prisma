generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum MissionType {
  DIARIA
  SEMANAL
  PERSONALIZADA
}

enum MissionStatus {
  NAO_INICIADA
  EM_PROGRESSO
  CONCLUIDA
  EXPIRADA
}

enum NotificationType {
  SISTEMA
  CONQUISTA
  MISSAO
  RANKING
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String
  role              Role      @default(ALUNO)
  avatar            String?
  refreshToken      String?   @map("refresh_token") @db.Text
  resetToken        String?   @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  currentStreak     Int       @default(0) @map("current_streak")
  longestStreak     Int       @default(0) @map("longest_streak")
  streakLastDate    DateTime? @map("streak_last_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  classEnrollments    ClassStudent[]
  points              UserPoint[]
  achievements        UserAchievement[]
  rankings            Ranking[]
  missions            UserMission[]
  missionQuizAttempts MissionQuizAttempt[]
  notifications       Notification[]
  posts               Post[]
  postReplies         PostReply[]
  createdClasses      Class[]

  @@map("users")
}

model Class {
  id          String   @id @default(uuid())
  name        String
  semester    String
  year        Int
  code        String   @unique @default(cuid())
  status      String   @default("ATIVA")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?          @relation(fields: [createdById], references: [id])
  students  ClassStudent[]
  missions  Mission[]
  posts     Post[]

  @@map("classes")
}

model ClassStudent {
  classId    String   @map("class_id")
  userId     String   @map("user_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@map("class_students")
}

model UserPoint {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  points      Int
  source      String
  description String   @db.Text
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  icon        String?
  category    String
  points      Int      @default(0)
  rarity      String   @default("COMUM")
  condition   String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  referenceId String?  @map("reference_id")
  position    Int
  points      Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([userId, type, referenceId])
  @@map("rankings")
}

model Mission {
  id          String      @id @default(uuid())
  classId     String?     @map("class_id")
  title       String
  description String      @db.Text
  type        MissionType
  points      Int         @default(0)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  class        Class?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz         MissionQuiz?
  userMissions UserMission[]
  quizAttempts MissionQuizAttempt[]

  @@map("missions")
}

model MissionQuiz {
  id             String     @id @default(uuid())
  missionId      String     @unique @map("mission_id")
  title          String     @db.VarChar(200)
  question       String     @db.Text
  difficulty     Difficulty
  options        Json
  explanations   Json
  correctIndex   Int        @map("correct_index")
  aiGenerationId String?    @map("ai_generation_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  mission      Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  aiGeneration AIGeneration?      @relation(fields: [aiGenerationId], references: [id])
  attempts     MissionQuizAttempt[]

  @@map("mission_quizzes")
}

model MissionQuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  missionId     String   @map("mission_id")
  missionQuizId String   @map("mission_quiz_id")
  selectedIndex Int      @map("selected_index")
  isCorrect     Boolean  @map("is_correct")
  answeredAt    DateTime @default(now()) @map("answered_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionQuiz MissionQuiz @relation(fields: [missionQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_quiz_attempts")
}

model UserMission {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  missionId   String        @map("mission_id")
  status      MissionStatus @default(NAO_INICIADA)
  progress    Int           @default(0)
  completedAt DateTime?     @map("completed_at")
  startedAt   DateTime      @default(now()) @map("started_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("user_missions")
}

model AIGeneration {
  id         String   @id @default(uuid())
  type       String
  prompt     String   @db.Text
  response   String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  missionQuizzes MissionQuiz[]

  @@map("ai_generations")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Post {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  authorId  String   @map("author_id")
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies PostReply[]

  @@map("posts")
}

model PostReply {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("post_replies")
}
