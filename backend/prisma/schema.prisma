generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum MissionType {
  DIARIA
  SEMANAL
  PERSONALIZADA
}

enum MissionStatus {
  NAO_INICIADA
  EM_PROGRESSO
  CONCLUIDA
  EXPIRADA
}

enum NotificationType {
  SISTEMA
  CONQUISTA
  MISSAO
  RANKING
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  role              Role     @default(ALUNO)
  avatar            String?
  refreshToken      String?  @map("refresh_token") @db.Text
  resetToken        String?  @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relações
  classEnrollments   ClassStudent[]
  points             UserPoint[]
  achievements       UserAchievement[]
  rankings           Ranking[]
  missions           UserMission[]
  missionQuizAttempts MissionQuizAttempt[]
  notifications      Notification[]
  aiGenerations      AIGeneration[]
  posts              Post[]
  postReplies        PostReply[]

  @@map("users")
}

model Class {
  id        String   @id @default(uuid())
  name      String
  semester  String
  year      Int
  code      String   @unique @default(cuid()) // Código único para entrar na turma
  status    String   @default("ATIVA") // ATIVA, ENCERRADA
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  students   ClassStudent[]
  missions   Mission[]
  posts      Post[]

  @@map("classes")
}

model ClassStudent {
  classId    String   @map("class_id")
  userId     String   @map("user_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  // Relações
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@map("class_students")
}

model UserPoint {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  points      Int      // Pontos ganhos nesta transação
  source      String   // ATIVIDADE, CONQUISTA, BONUS_PROFESSOR, MISSAO
  description String   @db.Text
  referenceId String?  @map("reference_id") // ID da atividade, conquista, etc
  createdAt   DateTime @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  icon        String?
  category    String   // SUBMISSÕES, PONTOS, NÍVEIS, ESPECIAL, etc
  points      Int      @default(0)
  rarity      String   @default("COMUM") // COMUM, INCOMUM, RARO, ÉPICO, LENDÁRIO
  condition   String   @unique // Identificador único para verificação automática
  criteria    String   @db.Text // JSON com critérios detalhados
  createdAt   DateTime @default(now()) @map("created_at")

  // Relações
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")
  earnedAt      DateTime @default(now()) @map("earned_at")

  // Relações
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Ranking {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   // GLOBAL, TURMA
  referenceId String?  @map("reference_id") // classId quando type = TURMA
  position    Int      // Posição no ranking
  points      Int      // Pontos totais
  period      String   @default("GERAL") // SEMANAL, MENSAL, GERAL
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([userId, type, referenceId])
  @@map("rankings")
}

model Mission {
  id          String      @id @default(uuid())
  classId     String?     @map("class_id")
  title       String
  description String      @db.Text
  type        MissionType
  points      Int         @default(0)
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relações
  class        Class?        @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz         MissionQuiz?
  userMissions UserMission[]
  quizAttempts MissionQuizAttempt[]

  @@map("missions")
}

model MissionQuiz {
  id             String   @id @default(uuid())
  missionId      String   @unique @map("mission_id")
  title          String   @db.VarChar(200)
  question       String   @db.Text
  difficulty     Difficulty
  options        Json
  explanations   Json
  correctIndex   Int      @map("correct_index")
  aiGenerationId String?  @map("ai_generation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  mission       Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  aiGeneration  AIGeneration? @relation(fields: [aiGenerationId], references: [id])
  attempts      MissionQuizAttempt[]

  @@map("mission_quizzes")
}

model MissionQuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  missionId     String   @map("mission_id")
  missionQuizId String   @map("mission_quiz_id")
  selectedIndex Int      @map("selected_index")
  isCorrect     Boolean  @map("is_correct")
  answeredAt    DateTime @default(now()) @map("answered_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionQuiz MissionQuiz @relation(fields: [missionQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("mission_quiz_attempts")
}

model UserMission {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  missionId   String             @map("mission_id")
  status      MissionStatus      @default(NAO_INICIADA)
  progress    Int                @default(0)
  completedAt DateTime?          @map("completed_at")
  startedAt   DateTime           @default(now()) @map("started_at")

  // Relações
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("user_missions")
}

model AIGeneration {
  id         String   @id @default(uuid())
  type       String   // QUESTAO, QUIZ, MISSAO, MOTIVACIONAL
  prompt     String   @db.Text
  response   String   @db.Text
  reviewedBy String?  @map("reviewed_by")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relações
  reviewer User? @relation(fields: [reviewedBy], references: [id])
  missionQuizzes MissionQuiz[]

  @@map("ai_generations")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Post {
  id          String   @id @default(uuid())
  classId     String?  @map("class_id")
  authorId    String   @map("author_id")
  title       String
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class     Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   PostReply[]

  @@map("posts")
}

model PostReply {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  authorId    String   @map("author_id")
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("post_replies")
}
